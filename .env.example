NEXT_PUBLIC_APP_NAME=Samzy Business Command Centre
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Model A — recommended: Gemini
AI_MODEL_A_PROVIDER=gemini
AI_MODEL_A_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL_A_API_KEY=
AI_MODEL_A_MODEL=

# Model B — recommended: Groq
AI_MODEL_B_PROVIDER=groq
AI_MODEL_B_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL_B_API_KEY=
AI_MODEL_B_MODEL=

# Model C — recommended: OpenRouter
AI_MODEL_C_PROVIDER=openrouter
AI_MODEL_C_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_C_API_KEY=
AI_MODEL_C_MODEL=

# Cloudflare Workers AI requires its account-specific OpenAI-compatible endpoint:
# https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# NVIDIA NIM: https://integrate.api.nvidia.com/v1
# Change provider, base URL, model and key together when switching a slot.

# Prospect research (Brave Search API; server-side only)
BRAVE_SEARCH_API_KEY=

# Email outreach delivery (Resend; sender domain must be verified with Resend)
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO_EMAIL=

# WhatsApp Cloud API (Meta; approved template required for business-initiated messages)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v22.0
# Configure an approved template with exactly one body variable ({{1}}) for the saved message text.
